{
  "name": "slime-republics-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Game client for Slime Republics: TypeScript + FlatBuffers over a WebSocket to the C++ server",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "vite build --ssr scripts/smoke.ts --outDir .smoke --emptyOutDir --logLevel warn && node .smoke/smoke.js"
  },
  "dependencies": {
    "flatbuffers": "^25.9.23"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "happy-dom": "^20.10.6",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
